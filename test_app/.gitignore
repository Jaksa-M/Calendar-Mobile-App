/android/app/release

# --- Added for cleanup / cross-platform (Windows + macOS) ---

# Android — machine-specific paths & build cache
/android/local.properties
/android/.gradle/
/android/app/.cxx/
/android/.kotlin/
/android/key.properties
*.keystore
*.jks

# Secrets — never commit a real .env anywhere; keep the .example template
.env
*.env
!*.env.example

# Backend (Python) — in case anything runs from the repo root
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/

# iOS / macOS — machine-generated
**/Flutter/flutter_export_environment.sh
**/ios/Flutter/.last_build_id
**/Pods/
**/ios/Podfile.lock
**/macos/Podfile.lock

# Windows build target (if you run `flutter build windows` on the other PC)
/windows/flutter/ephemeral/
/linux/flutter/ephemeral/

